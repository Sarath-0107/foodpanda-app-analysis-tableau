      <group caption='Restaurant Name Set' name='[Restaurant Name Set]' name-style='unqualified' user:ui-builder='filter-group'>
        <groupfilter count='2' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
          <groupfilter direction='DESC' expression='SUM([rating])' function='order' user:ui-marker='order'>
            <groupfilter function='level-members' level='[restaurant_name]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </groupfilter>
        </groupfilter>
      </group>
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[cum:sum:order_frequency:ok]' type='palette'>
            <map to='#34844a'>
              <bucket>30969</bucket>
            </map>
            <map to='#5aa355'>
              <bucket>30828</bucket>
            </map>
            <map to='#76b7b2'>
              <bucket>31182</bucket>
            </map>
            <map to='#a3bd5a'>
              <bucket>30374</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>0</bucket>
            </map>
            <map to='#f4d166'>
              <bucket>28475</bucket>
            </map>
          </encoding>
          <encoding attr='shape' field='[none:gender:nk]' type='shape'>
            <map to='Gender/1.png'>
              <bucket>&quot;Male&quot;</bucket>
            </map>
            <map to='Gender/2.png'>
              <bucket>&quot;Female&quot;</bucket>
            </map>
            <map to='Gender/3.png'>
              <bucket>&quot;Other&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:delivery_status:nk]' type='palette'>
            <map to='#4e79a7'>
              <bucket>&quot;Delivered&quot;</bucket>
            </map>
            <map to='#e15759'>
              <bucket>&quot;Cancelled&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;Delayed&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[Restaurant Name (group)]' type='palette'>
            <map to='#4e79a7'>
              <bucket>&quot;KFC &amp; Subway&quot;</bucket>
            </map>
            <map to='#a2a2a2'>
              <bucket>&quot;Other&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:restaurant_name:nk]' type='palette'>
            <map to='#59a14f'>
              <bucket>&quot;Subway&quot;</bucket>
            </map>
            <map to='#76b7b2'>
              <bucket>&quot;Pizza Hut&quot;</bucket>
            </map>
            <map to='#e15759'>
              <bucket>&quot;KFC&quot;</bucket>
            </map>
            <map to='#edc948'>
