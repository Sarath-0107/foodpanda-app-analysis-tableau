      <column-instance column='[order_frequency]' derivation='Sum' name='[cum:sum:order_frequency:ok]' pivot='key' type='ordinal'>
        <table-calc aggregation='Sum' ordering-type='Rows' type='CumTotal' />
      </column-instance>
      <column-instance column='[order_frequency]' derivation='Max' name='[max:order_frequency:qk]' pivot='key' type='quantitative' />
